* {
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #101b2d;
    margin: 0;
    min-height: 100vh;
    padding: 30px 20px;
    display: flex;
    justify-content: center;
    align-items: center;
    color: #ffffff;
}

.contenedor {
    width: 100%;
    max-width: 500px;
    margin: auto;
    background: #1b2940;
    padding: 35px;
    border-radius: 12px;
    border: 1px solid #34445e;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3);
}

h1 {
    text-align: center;
    color: #eeb323;
    font-size: 30px;
    margin: 0 0 10px;
}

h2 {
    text-align: center;
    color: #ffffff;
    font-size: 22px;
    margin: 0 0 25px;
}

label {
    display: block;
    margin-top: 20px;
    margin-bottom: 8px;
    font-weight: bold;
    color: #e4eaf2;
}

input {
    width: 100%;
    padding: 13px;
    background: #101b2d;
    color: #ffffff;
    border: 1px solid #465873;
    border-radius: 6px;
    font-size: 15px;
    outline: none;
    transition: border-color 0.2s;
}

input:focus {
    border-color: #eeb323;
}

input::placeholder {
    color: #8492a6;
}

button {
    width: 100%;
    padding: 14px;
    margin-top: 28px;
    background: #eeb323;
    color: #172235;
    border: none;
    border-radius: 6px;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
    transition: background 0.2s;
}

button:hover {
    background: #d49d12;
}

.mensaje {
    background: #48252b;
    color: #ffb5b5;
    padding: 14px;
    border: 1px solid #a74750;
    border-radius: 7px;
    margin-top: 20px;
    text-align: center;
}

.resultado {
    background: #183c32;
    color: #a8e6c5;
    padding: 15px;
    border: 1px solid #287653;
    border-radius: 7px;
    margin-top: 20px;
    overflow-wrap: anywhere;
}

.logout {
    display: block;
    text-align: center;
    margin-top: 22px;
    color: #eeb323;
    text-decoration: none;
    transition: color 0.2s;
}

.logout:hover {
    color: #ffffff;
    text-decoration: underline;
}

@media (max-width: 600px) {
    body {
        padding: 20px 12px;
    }

    .contenedor {
        padding: 25px 20px;
    }

    h1 {
        font-size: 25px;
    }

    h2 {
        font-size: 20px;
    }
}
